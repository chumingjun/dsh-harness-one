  },
  "keywords": [
    "deepseek",
    "dsh",
    "dsh-plugin",
    "ai-agents",
    "agentic-workflow",
    "workflow-automation",
    "visual-workflow",
    "multi-agent",
    "dag",
    "react-flow",
    "feishu",
    "lark",
    "cordis"
  ],
  "engines": {
    "node": ">=20"
