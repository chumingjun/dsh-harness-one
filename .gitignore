#   web-dist = build-web.sh 产物（vite /wf1/ base，插件静态托管用）
#   canvasui lib/client.js = build-canvasui.sh 产物（src/client.js 内联 shared/ 片段）
dist/
dsh-plugins/dsh-ccpg-web/web-dist/
dsh-plugins/dsh-ccpg-canvasui/lib/client.js

# macOS
.DS_Store

# GUI test screenshots (local verification artifacts, not referenced by docs)
gui-test-screenshots/

# release packaging output
dist-release/

# runtime state (top-level Express fallback demo)
data/graph.json

# workspace-local Workflow One state (graph, workflows, runs, node outputs, uploads)
.workflow-one/

